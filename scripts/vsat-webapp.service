[Unit]
Description=VSAT Cluster v2 web app
After=network-online.target snap.lxd.daemon.service
Wants=network-online.target

[Service]
Type=simple
# Runs as root so it can drive lxc and bind :443. Drop privileges + use --sudo
# instead if you prefer a non-root service account in the lxd group.
ExecStart=/usr/local/bin/vsat-webapp --addr :443 --config-dir /etc/vsat-cluster
Restart=on-failure
RestartSec=3
Environment=VSAT_CONFIG_DIR=/etc/vsat-cluster
# Allow binding privileged ports without full root if you switch User=.
AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
